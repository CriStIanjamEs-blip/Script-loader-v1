-- God Mode + Anti-Drop
local godModeEnabled = false
local godConnection = nil
local toolConnections = {}

local function setToolsCanBeDropped(value)
	-- Character tools
	if player.Character then
		for _, tool in pairs(player.Character:GetChildren()) do
			if tool:IsA("Tool") then
				tool.CanBeDropped = value
			end
		end
	end
	-- Backpack tools
	for _, tool in pairs(player.Backpack:GetChildren()) do
		if tool:IsA("Tool") then
			tool.CanBeDropped = value
		end
	end
end

local function setupAntiDrop()
	-- Clear old connections
	for _, conn in pairs(toolConnections) do
		conn:Disconnect()
	end
	toolConnections = {}

	-- When new tool is added to backpack
	table.insert(toolConnections, player.Backpack.ChildAdded:Connect(function(child)
		if godModeEnabled and child:IsA("Tool") then
			child.CanBeDropped = false
		end
	end))

	-- When tool is equipped
	if player.Character then
		table.insert(toolConnections, player.Character.ChildAdded:Connect(function(child)
			if godModeEnabled and child:IsA("Tool") then
				child.CanBeDropped = false
			end
		end))
	end
end

godModeBtn.MouseButton1Click:Connect(function()
	godModeEnabled = not godModeEnabled

	if godModeEnabled then
		godModeBtn.Text = "God Mode: ON"
		godModeBtn.BackgroundColor3 = Color3.fromRGB(40, 90, 50)
		statusLabel.Text = "God Mode Enabled (Anti-Drop)"
		statusLabel.TextColor3 = Color3.fromRGB(80, 220, 120)

		-- Enable anti-drop
		setToolsCanBeDropped(false)
		setupAntiDrop()

		local function enableGod(char)
			local humanoid = char:FindFirstChildOfClass("Humanoid")
			if humanoid then
				if godConnection then
					godConnection:Disconnect()
				end
				godConnection = humanoid.HealthChanged:Connect(function()
					if godModeEnabled and humanoid.Health < humanoid.MaxHealth then
						humanoid.Health = humanoid.MaxHealth
					end
				end)
				humanoid.Health = humanoid.MaxHealth
			end

			-- Re-apply anti-drop on new character
			setToolsCanBeDropped(false)
			setupAntiDrop()
		end

		if player.Character then
			enableGod(player.Character)
		end

		player.CharacterAdded:Connect(function(char)
			if godModeEnabled then
				task.wait(0.3)
				enableGod(char)
			end
		end)
	else
		godModeBtn.Text = "God Mode: OFF"
		godModeBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 42)
		statusLabel.Text = "God Mode Disabled"
		statusLabel.TextColor3 = Color3.fromRGB(160, 160, 170)

		-- Allow dropping again
		setToolsCanBeDropped(true)

		if godConnection then
			godConnection:Disconnect()
			godConnection = nil
		end

		for _, conn in pairs(toolConnections) do
			conn:Disconnect()
		end
		toolConnections = {}
	end
end)

-- FPS + MS Counter
local lastTime = tick()
local frames = 0
local fps = 0

RunService.RenderStepped:Connect(function()
	frames += 1
	local now = tick()
	if now - lastTime >= 1 then
		fps = frames
		frames = 0
		lastTime = now
	end

	local ms = math.floor((1 / math.max(fps, 1)) * 1000)
	fpsMsLabel.Text = string.format("FPS: %d  |  MS: %d", fps, ms)
end)

-- Avatar Weight Editor
applyWeightBtn.MouseButton1Click:Connect(function()
	local weight = tonumber(weightBox.Text)
	if not weight or weight <= 0 then
		statusLabel.Text = "Enter a valid number > 0"
		statusLabel.TextColor3 = Color3.fromRGB(255, 150, 80)
		return
	end

	local char = player.Character
	if not char then
		statusLabel.Text = "No character found"
		statusLabel.TextColor3 = Color3.fromRGB(255, 90, 90)
		return
	end

	local success = pcall(function()
		for _, part in pairs(char:GetDescendants()) do
			if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
				local current = part.CustomPhysicalProperties or PhysicalProperties.new(0.7, 0.3, 0.5)
				part.CustomPhysicalProperties = PhysicalProperties.new(
					weight,
					current.Friction,
					current.Elasticity,
					current.FrictionWeight,
					current.ElasticityWeight
				)
			end
		end
	end)

	if success then
		statusLabel.Text = "Weight set to " .. tostring(weight)
		statusLabel.TextColor3 = Color3.fromRGB(80, 220, 120)
	else
		statusLabel.Text = "Failed to set weight"
		statusLabel.TextColor3 = Color3.fromRGB(255, 90, 90)
	end
end)

