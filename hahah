			for _, server in pairs(result.data) do
				if typeof(server.playing) == "number" and server.playing >= 1 and count < 12 then
					createServerEntry(server.id, server.playing, y)
					y = y + 48
					count = count + 1
				end
			end
			serverScroll.CanvasSize = UDim2.new(0, 0, 0, y + 10)
			if count > 0 then
				statusLabel.Text = "Found " .. count .. " low player servers"
				statusLabel.TextColor3 = Color3.fromRGB(80, 220, 120)
			else
				statusLabel.Text = "No suitable servers found"
				statusLabel.TextColor3 = Color3.fromRGB(255, 150, 80)
			end
		else
			statusLabel.Text = "Failed to fetch servers"
			statusLabel.TextColor3 = Color3.fromRGB(255, 90, 90)
		end
	end)
end)

